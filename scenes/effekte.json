{
  "version": 1,
  "name": "Effekte",
  "description": "Lagerfeuer mit Rauch und Funkenflug in einer verschneiten Nacht, ein magischer Kristall, eine Fontäne und eine Explosion bei 2 Sekunden.",
  "duration": 5,
  "environment": {
    "sky": { "type": "color", "color": "#0b1020" },
    "sun": { "azimuth": 200, "elevation": 30, "intensity": 0.05, "color": "#9fb4ff" },
    "ambient": 0.15,
    "exposure": 2.5,
    "bloom": 0.35,
    "fog": { "visibility": 120, "color": "#141a2e" }
  },
  "camera": { "position": [0, 3, 13], "look_at": [0, 1.4, 0], "fov": 50 },
  "objects": [
    { "id": "boden", "type": "terrain", "size": [200, 200], "resolution": 128, "height": 1.5, "style": "hills", "feature_size": 25, "flat_center_radius": 12,
      "material": { "color": "#e8eef8", "roughness": 0.9 } },
    { "id": "feuerstelle", "type": "group", "children": [
      { "id": "steine", "type": "sphere", "radius": 0.25, "position": [1.0, 0.1, 0],
        "repeat": { "count": 10, "rotation": [0, 36, 0], "pivot": [-1.0, 0, 0] },
        "material": { "color": "#55575c", "flat": true } },
      { "id": "holz", "type": "cylinder", "radius": 0.09, "height": 1.4, "position": [0, 0.2, 0], "rotation": [0, 0, 80],
        "repeat": { "count": 4, "rotation": [0, 45, 0] }, "material": { "color": "#3b2414" } },
      { "id": "feuer", "type": "particles", "preset": "fire", "position": [0, 0.25, 0] },
      { "id": "rauch", "type": "particles", "preset": "smoke", "position": [0, 1.6, 0] },
      { "id": "funken", "type": "particles", "preset": "sparks", "rate": 25, "position": [0, 0.5, 0], "speed": [1.5, 4] },
      { "id": "feuerlicht", "type": "point_light", "position": [0, 1.0, 0], "color": "#ff8a3a", "intensity": 60000, "range": 25, "shadows": true,
        "animate": { "flicker": 0.4 } }
    ]},
    { "id": "schnee", "type": "particles", "preset": "snow", "position": [0, 12, 0], "area": [30, 0.5, 30] },
    { "id": "kristall", "type": "lathe", "profile": [[0, 0], [0.35, 0.6], [0, 1.6]], "segments": 6, "position": [-4.5, 0.4, -1],
      "material": { "color": "#bde0fe", "emissive": "#7b2ff7", "emissive_strength": 4, "flat": true, "roughness": 0.1 },
      "animate": { "spin": [0, 40, 0], "position": [{ "t": 0, "v": [-4.5, 0.4, -1] }, { "t": 2.5, "v": [-4.5, 0.8, -1] }, { "t": 5, "v": [-4.5, 0.4, -1] }] } },
    { "id": "magie", "type": "particles", "preset": "magic", "position": [-4.5, 1.2, -1] },
    { "id": "brunnen", "type": "lathe", "profile": [[0, 0], [1.1, 0], [1.1, 0.5], [0.95, 0.5], [0.95, 0.15], [0, 0.15]], "position": [4.5, 0, -2],
      "material": { "color": "#8d99ae", "roughness": 0.7 } },
    { "id": "fontaene", "type": "particles", "preset": "fountain", "position": [4.5, 0.3, -2], "speed": [4, 4.6] },
    { "id": "explosion", "type": "particles", "preset": "explosion", "position": [7, 2.5, -12], "start": 2.0 },
    { "id": "explosion_blitz", "type": "point_light", "position": [7, 3, -10], "color": "#ffb36b", "intensity": 0, "range": 60,
      "animate": { "intensity": [{ "t": 1.99, "v": 0 }, { "t": 2.05, "v": 3000000, "ease": "linear" }, { "t": 3.2, "v": 0, "ease": "out" }] } },
    { "id": "explosion_rauch", "type": "particles", "preset": "smoke", "burst": 60, "start": 2.1, "speed": [1, 3], "spread": 180,
      "size": [1.5, 5], "lifetime": [2, 3], "position": [7, 2.5, -12] }
  ]
}
